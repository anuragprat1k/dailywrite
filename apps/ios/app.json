{
  "expo": {
    "name": "Daily Write",
    "slug": "dailywrite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dailywrite",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailywrite.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["dailywrite"]
          }
        ]
      }
    },
    "splash": {
      "backgroundColor": "#1e293b",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
